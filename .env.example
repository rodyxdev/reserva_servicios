# =====================================================================
#  SISTEMA DE RESERVAS — CONFIGURACION DE ENTORNO
# =====================================================================
#  Copia este archivo a .env y rellena los valores reales.
#
#      cp .env.example .env
#
#  .env NUNCA se sube al repositorio (esta en .gitignore).
#  Este archivo (.env.example) SI se sube, pero solo con placeholders.
# =====================================================================

# ---------------------------------------------------------------------
#  APLICACION
# ---------------------------------------------------------------------
# production | development
# En development se muestran los errores en pantalla. En production se
# registran en storage/logs y el usuario ve una pagina generica.
APP_ENV=development
APP_DEBUG=true

# URL base sin barra final. Se usa para construir los links de los correos
# (confirmacion, cancelacion), que deben ser absolutos.
APP_URL=http://localhost:8080

# Nombre visible en correos y en el titulo del panel.
APP_NAME="Spa Aurora"

# Clave para firmar/proteger la sesion. Genera una propia con:
#     php -r "echo bin2hex(random_bytes(32));"
APP_KEY=CAMBIA_ESTO_POR_UNA_CADENA_ALEATORIA_DE_64_CARACTERES

# Negocio que sirve la interfaz publica. El esquema es multi-tenant, pero
# la v1 atiende un solo negocio: este.
APP_BUSINESS_ID=1

# ---------------------------------------------------------------------
#  BASE DE DATOS
# ---------------------------------------------------------------------
# Con docker-compose el host es "mysql" (nombre del servicio).
# Con XAMPP en local es "127.0.0.1".
# En InfinityFree te dan un host tipo "sqlXXX.infinityfree.com".
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reservas
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------
#  CORREO (SMTP)
# ---------------------------------------------------------------------
# Para desarrollo se recomienda Mailtrap: captura todos los correos en una
# bandeja de prueba sin entregarlos a nadie de verdad.
# Crea una inbox gratis en mailtrap.io y copia aqui sus credenciales SMTP.
#
#   Mailtrap Sandbox:  sandbox.smtp.mailtrap.io  puerto 2525  encryption tls
#   Gmail:             smtp.gmail.com            puerto 587   (requiere App Password)
#   InfinityFree:      no ofrece SMTP saliente propio; usa un servicio externo
#
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=TU_USUARIO_MAILTRAP
MAIL_PASSWORD=TU_PASSWORD_MAILTRAP
# tls | ssl | (vacio para sin cifrado)
MAIL_ENCRYPTION=tls

# Remitente de todos los correos salientes.
MAIL_FROM_ADDRESS=no-responder@spa-aurora.test
MAIL_FROM_NAME="Spa Aurora"

# Buzon del negocio que recibe el aviso de cada nueva reserva.
# Si se deja vacio, se usa businesses.email de la base de datos.
MAIL_BUSINESS_NOTIFY=

# Poner en true para NO enviar nada y solo escribir los correos en
# storage/logs/mail.log. Util para desarrollar sin credenciales SMTP.
MAIL_PRETEND=false

# Pausa minima entre envios, en milisegundos. Los SMTP compartidos limitan
# la tasa: el sandbox gratuito de Mailtrap rechaza con "550 Too many emails
# per second" si se le mandan dos seguidos. Con un SMTP propio sin limite
# se puede poner 0.
MAIL_THROTTLE_MS=1100

# ---------------------------------------------------------------------
#  SEGURIDAD
# ---------------------------------------------------------------------
# Login del panel: intentos fallidos antes de bloquear la cuenta,
# y duracion del bloqueo en minutos.
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Antelacion minima (minutos) para que el cliente cancele por si mismo
# desde el enlace del correo. Debe ser MENOR que el min_advance_minutes
# del negocio: si fueran iguales, quien reserva justo en el limite se
# quedaria sin poder cancelar desde el primer instante.
CANCEL_MIN_NOTICE_MINUTES=60

# Rate limit del endpoint publico de reservas: N intentos por IP
# dentro de una ventana deslizante de M minutos.
RATE_LIMIT_BOOKING_MAX=5
RATE_LIMIT_BOOKING_WINDOW=10

# Si la app corre detras de un proxy o CDN (Cloudflare, nginx), la IP real
# viene en una cabecera. Dejar en false salvo que se confie en el proxy:
# activarlo sin proxy delante permite falsificar la IP y saltarse el limite.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------
#  DESPLIEGUE POR FTP (scripts/deploy.sh)
# ---------------------------------------------------------------------
# Estos valores NO se leen desde .env: el script los toma de variables de
# entorno del shell para no dejar credenciales en un archivo del proyecto.
# Se listan aqui solo como documentacion de que necesita el script.
#
#   export DEPLOY_FTP_HOST="ftpupload.net"
#   export DEPLOY_FTP_USER="if0_XXXXXXXX"
#   export DEPLOY_FTP_PASS="tu_password_ftp"
#   export DEPLOY_FTP_PATH="/htdocs"
